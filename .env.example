# Скопіюй цей файл у .env і підстав свої значення. Файл .env НІКОЛИ не комітимо.
# Рядок підключення до БД дає викладач (read-only користувач).
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Ключ Gemini API (створюється в Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Основна й запасна моделі Gemini (актуальні назви: https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# off = агент відповідає лише за шаблоном, без виклику Gemini
LLM_MODE=on